# Copiez ce fichier en .env si vous voulez une configuration locale.
# run.py charge automatiquement .env au démarrage.
# Les variables déjà définies dans le shell restent prioritaires.

# -----------------------------
# Git / repositories
# -----------------------------

# Liste de racines à scanner, séparées par le séparateur système.
# Linux/macOS : ":" | Windows : ";"
DEVTOOLS_ROOT_DIRS=/home/you/code/pers:/home/you/code/bricolage

# Remote Git par défaut
DEVTOOLS_REMOTE=origin

# Branche d'intégration utilisée pour les auto-commits et les merges
DEVTOOLS_HEAD_BRANCH=staging

# Décommentez si vous voulez forcer une branche de base unique.
# Sinon l'outil essaie d'utiliser origin/HEAD puis fallback master.
# DEVTOOLS_BASE_BRANCH=main

# Timeout par défaut des commandes git
DEVTOOLS_GIT_TIMEOUT=60

# Attente max pour constater qu'une PR GitHub est effectivement merge
GH_PR_MERGE_TIMEOUT=90

# -----------------------------
# Ollama
# -----------------------------

# 1 = activé, 0 = désactivé
ENABLE_OLLAMA=1

# Usage local recommandé
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_TIMEOUT=60

# Optionnel, doit rester >= 512 si défini
# OLLAMA_NUM_CTX=8192

# Limites de contexte envoyées au modèle
OLLAMA_MAX_FILES=80
OLLAMA_MAX_DIFF_CHARS=4500
OLLAMA_MAX_PR_SUMMARY_CHARS=5000
OLLAMA_MAX_REVIEW_DIFF_CHARS=12000
OLLAMA_MAX_REVIEW_FILE_CHARS=14000

# -----------------------------
# Garde-fous sécurité
# -----------------------------

# Autorise un host Ollama non local.
# Ne pas activer si vous utilisez uniquement localhost.
# OLLAMA_ALLOW_REMOTE=1

# Autorise l'envoi de diff Git et résumés de commits vers un host distant.
# À activer uniquement si vous acceptez explicitement cet envoi.
# OLLAMA_ALLOW_REMOTE_CONTEXT=1

# Debug Ollama:
# 0    -> rien
# 1    -> aperçu tronqué
# full -> sortie complète
OLLAMA_DEBUG=0
OLLAMA_DEBUG_MAX_CHARS=400
